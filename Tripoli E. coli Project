const PARTS = [
  {n:1,k:'flag',t:'Flagella',c:'var(--flag)',d:'Whip-like filaments that swim the cell.',m:'Each flagellum is turned by a tiny rotary motor in the membrane. Swimming helps bacteria move up the urinary tract against the flow of urine.'},
  {n:2,k:'fim',t:'Type 1 fimbriae',c:'var(--fim)',d:'Short hairs that stick to the bladder wall.',m:'The tip protein FimH binds to receptors on bladder cells. P fimbriae, a related type, are linked to kidney infection.'},
  {n:3,k:'om',t:'Outer membrane',c:'var(--om)',d:'The outer skin of a Gram-negative cell.',m:'It contains lipopolysaccharide and porin channels. Antibiotics enter through porins, so losing a porin can add to carbapenem resistance.'},
  {n:4,k:'pg',t:'Peptidoglycan wall',c:'var(--pg)',d:'A thin mesh that gives the cell its shape.',m:'It is the target of penicillins, cephalosporins and carbapenems. ESBL and carbapenemase enzymes sit just outside it and break these drugs down.'},
