  $('#detail').innerHTML = `<h2>Isolate profile</h2><h3>${x.id}</h3>
    <dl class="kv"><dt>Patient</dt><dd>${x.sex==='F'?'Female':'Male'}, ${x.age} years</dd><dt>Phoenix panel</dt><dd>${x.panel}</dd><dt>Agents tested</dt><dd>${x.res.filter(cat).length} with a category</dd></dl>
    <div class="pills">${pills}</div>
    <p class="druglist"><b>Resistant to</b>${R.length?R.map(esc).join(', '):'None reported'}</p>
    <p class="druglist"><b>Intermediate to</b>${I.length?I.map(esc).join(', '):'None reported'}</p>
    <div class="gene"><b>Gene results</b><br>Real-time PCR is still being confirmed for this isolate.<div class="gt"><span>NDM &middot; &hellip;</span><span>OXA-48 &middot; &hellip;</span><span>KPC &middot; &hellip;</span><span>CTX-M &middot; &hellip;</span><span>TEM &middot; &hellip;</span><span>SHV &middot; &hellip;</span></div></div>`;
}
function render(){
  const list = subset();
  if(sel && !list.some(x=>x.id===sel)) sel = null;
  renderChips(); renderTiles(list); renderBars(list); renderGrid(list); renderDetail(list);
}
document.addEventListener('click',e=>{
  const c=e.target.closest('.chip'); if(c){cur=c.dataset.k; try{localStorage.setItem('ecoli-filter',cur)}catch(_){} render(); return;}
  const b=e.target.closest('.rowbtn'); if(b){sel = sel===b.dataset.id?null:b.dataset.id; render(); if(sel) $('#detail').scrollIntoView({block:'nearest',behavior:'smooth'});}
