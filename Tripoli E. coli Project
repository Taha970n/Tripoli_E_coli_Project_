  }).join('');
}
function renderTiles(list){
  const n=list.length, c=k=>list.filter(x=>x[k]).length;
  const t=[['Isolates',n,'urine, E. coli'],['ESBL-flagged',c('esbl'),'Phoenix resistance marker'],['Multidrug-resistant',c('mdr'),'3+ drug classes, R only'],['Carbapenem-resistant',c('carb'),'ertapenem, imipenem or meropenem'],['Pan-susceptible',c('pan'),'no R or I result']];
  $('#tiles').innerHTML = t.map(([l,v,s])=>`<div class="tile"><div class="v">${v}<small>${n?Math.round(v/n*100):0}%</small></div><div class="l"><b style="font-weight:600;color:var(--ink)">${l}</b><br>${s}</div></div>`).join('');
