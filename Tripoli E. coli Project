const subset = () => ISO.filter(FILTERS.find(f=>f.k===cur).f);
const cat = v => (v==='R'||v==='I'||v==='S') ? v : null;

function stats(list){
  return D.map((d,j)=>{
    let n=0,r=0,i=0;
    list.forEach(x=>{const v=cat(x.res[j]); if(v){n++; if(v==='R')r++; if(v==='I')i++;}});
    return {d,n,r,i};
  });
}
function esc(s){return String(s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}

function renderChips(){
  $('#chips').innerHTML = '<span class="lab">Show</span>' + FILTERS.map(f=>{
    const n = ISO.filter(f.f).length;
