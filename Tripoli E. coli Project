    return `<tr class="${sel===x.id?'sel':''}"><th scope="row"><button type="button" class="rowbtn" data-id="${x.id}">${x.id}</button></th>${tds}<td>${fl}</td></tr>`;
  }).join('');
  $('#hm').innerHTML = head + '<tbody>'+body+'</tbody>';
}
function renderDetail(list){
  const x = ISO.find(i=>i.id===sel) || null;
  if(!x){
    $('#detail').innerHTML = `<h2>Isolate profile</h2><div class="empty" style="padding:8px 0">Click an isolate code in the grid to see its profile here.</div>
      <div class="gene"><b>Gene results</b><br>Real-time PCR for NDM, OXA-48, KPC, CTX-M, TEM and SHV is still being confirmed. Results will appear here per isolate.</div>`;
    return;
