];
function cellSVG(withBadges, id){
  const X0=200,X1=560,Y0=90,Y1=210,R=60,CY=150,CXL=X0+R,CXR=X1-R;
  const NS='http://www.w3.org/2000/svg';
  let s=`<svg viewBox="0 34 640 236" role="img" aria-label="Cut-away drawing of an E. coli cell showing flagella, fimbriae, membranes, wall, DNA, plasmids and ribosomes" ${id?`id="${id}"`:''}>`;
  // fimbriae
  let fim='';let k=0;
  const addF=(bx,by,nx,ny,len)=>{const ex=bx+nx*len,ey=by+ny*len,off=(k++%7)*0.4;
    fim+=`<g><line x1="${bx.toFixed(1)}" y1="${by.toFixed(1)}" x2="${ex.toFixed(1)}" y2="${ey.toFixed(1)}" stroke="var(--fim)" stroke-width="1.6" stroke-linecap="round"/><circle cx="${ex.toFixed(1)}" cy="${ey.toFixed(1)}" r="2.2" fill="var(--fim)"/><animateTransform attributeName="transform" type="rotate" values="-7 ${bx.toFixed(1)} ${by.toFixed(1)};7 ${bx.toFixed(1)} ${by.toFixed(1)};-7 ${bx.toFixed(1)} ${by.toFixed(1)}" dur="3.4s" begin="-${off.toFixed(1)}s" repeatCount="indefinite"/></g>`};
  for(let x=CXL+6;x<=CXR-6;x+=26){addF(x,Y0-2,0,-1,20);addF(x+13,Y1+2,0,1,20)}
  // left cap angles from 100 to 260 deg (skip the flagella region 150-210 mid) ; right cap only upper/lower thirds
  for(let a=105;a<=255;a+=15){ if(a>=160&&a<=200) continue; const r=a*Math.PI/180; addF(CXL+(R+2)*Math.cos(r),CY-(R+2)*Math.sin(r)*-1*-1, Math.cos(r), -Math.sin(r)*-1*-1, 18)}
  s+=`<g class="part" data-part="fim">${fim}</g>`;
  // flagella
  let fl='';const bases=[[X0-1,128],[X0-2,150],[X0-1,172]];
  bases.forEach((b,i)=>{
    const mk=ph=>{let d='';for(let j=0;j<=36;j++){const t=j/36,x=b[0]-t*175,y=b[1]+(i-1)*t*34+Math.sin(t*9+ph+i)*10*t*1.3;d+=(j?'L':'M')+x.toFixed(1)+' '+y.toFixed(1)}return d};
    fl+=`<path d="${mk(0)}" fill="none" stroke="var(--flag)" stroke-width="2.4" stroke-linecap="round"><animate attributeName="d" dur="1.6s" repeatCount="indefinite" values="${mk(0)};${mk(Math.PI)};${mk(2*Math.PI)}" begin="-${i*0.4}s"/></path>`;
  });
  s+=`<g class="part" data-part="flag">${fl}</g>`;
  const rr=(ins)=>`x="${X0+ins}" y="${Y0+ins}" width="${X1-X0-2*ins}" height="${Y1-Y0-2*ins}" rx="${R-ins}"`;
  // layers
  s+=`<g class="part" data-part="om"><rect ${rr(0)} fill="none" stroke="var(--om)" stroke-width="5"/></g>`;
  s+=`<g class="part" data-part="pg"><rect ${rr(7)} fill="none" stroke="var(--pg)" stroke-width="2.6" stroke-dasharray="7 2.5"/></g>`;
  s+=`<g class="part" data-part="im"><rect ${rr(13)} fill="var(--cyto)" stroke="var(--im)" stroke-width="4"/></g>`;
  // nucleoid
  const nuc='M300 150 C 310 118, 345 112, 360 132 S 395 170, 372 176 S 322 168, 332 148 S 372 124, 392 138 S 420 160, 404 164';
  s+=`<g class="part" data-part="dna"><path d="${nuc}" fill="none" stroke="var(--dna)" stroke-width="3.2" stroke-linecap="round"><animate attributeName="stroke-dashoffset" values="0;-30" dur="6s" repeatCount="indefinite"/></path><path d="M290 146 C 285 130, 300 120, 312 126 M410 150 C 425 140, 436 150, 430 160" fill="none" stroke="var(--dna)" stroke-width="3.2" stroke-linecap="round"/></g>`;
  // plasmids
  const pl=[[455,128,9],[470,172,7],[262,168,8]];
  s+=`<g class="part" data-part="plas">${pl.map((p,i)=>`<circle cx="${p[0]}" cy="${p[1]}" r="${p[2]}" fill="none" stroke="var(--plas)" stroke-width="2.6"><animate attributeName="cy" values="${p[1]};${p[1]-4};${p[1]}" dur="${4+i}s" repeatCount="indefinite"/></circle>`).join('')}</g>`;
  // ribosomes (deterministic scatter)
  let rb='';let seed=7;const rnd=()=>{seed=(seed*9301+49297)%233280;return seed/233280};
  for(let i=0;i<46;i++){const x=240+rnd()*290,y=112+rnd()*76;const dx=x-(rnd()<0.5?0:0);
    // keep inside rounded rect and away from nucleoid box
    const inCap=(x<CXL&&Math.hypot(x-CXL,y-CY)>R-22)||(x>CXR&&Math.hypot(x-CXR,y-CY)>R-22);if(inCap)continue;
    if(x>292&&x<440&&y>114&&y<182)continue;
    rb+=`<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="2.6" fill="var(--ribo)"/>`}
  s+=`<g class="part" data-part="ribo">${rb}</g>`;
  if(withBadges){
    const B=(n,x,y)=>`<g class="badge"><circle cx="${x}" cy="${y}" r="10"/><text x="${x}" y="${y+.5}">${n}</text></g>`;
    const pt=(a,r)=>[CXR+r*Math.cos(a*Math.PI/180),CY-r*Math.sin(a*Math.PI/180)];
    const L=(x1,y1,x2,y2)=>`<line class="lead-l" x1="${x1}" y1="${y1}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}"/>`;
    const tOM=pt(35,60),tPG=pt(20,53),tIM=pt(5,47);
    s+=L(606,92,...tOM)+L(606,122,...tPG)+L(606,150,...tIM);
    s+=B(3,614,92)+B(4,614,122)+B(5,614,150);
    s+=B(1,95,98)+B(2,330,56)+B(6,345,150)+B(7,455,150)+B(8,262,134);
  }
  return s+'</svg>';
}
(function(){
  document.getElementById('heroStage').innerHTML=cellSVG(false);
  document.getElementById('anatStage').innerHTML=cellSVG(true,'anatSvg');
  const box=document.getElementById('parts'),svg=document.getElementById('anatSvg');
  box.innerHTML=PARTS.map(p=>`<button class="pbtn" type="button" data-k="${p.k}" aria-pressed="false"><span class="no" style="background:${p.c}">${p.n}</span><span><strong>${p.t}</strong><span class="d">${p.d}</span><span class="more">${p.m}</span></span></button>`).join('');
  let pinned=null;
  const focus=k=>{ if(k){svg.dataset.focus=k;svg.querySelectorAll('.part').forEach(g=>g.classList.toggle('on',g.dataset.part===k))} else {delete svg.dataset.focus} };
  box.addEventListener('mouseover',e=>{const b=e.target.closest('.pbtn');if(b&&!pinned)focus(b.dataset.k)});
  box.addEventListener('mouseleave',()=>{if(!pinned)focus(null)});
  box.addEventListener('focusin',e=>{const b=e.target.closest('.pbtn');if(b&&!pinned)focus(b.dataset.k)});
  box.addEventListener('click',e=>{const b=e.target.closest('.pbtn');if(!b)return;
    pinned = pinned===b.dataset.k?null:b.dataset.k;
    box.querySelectorAll('.pbtn').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.k===pinned)));
    focus(pinned||b.dataset.k); if(!pinned)focus(null);});
  // world chart
  const rows=[['World, 2023 (WHO)',40,'u','over 40%','over 40%'],['African Region (WHO)',70,'u','above 70%','above 70%'],['Our isolates (ceftriaxone)',35,'g','35%','7 of 20']];
  document.getElementById('cmp').innerHTML=rows.map(r=>`<div class="brow"><div class="nm">${r[0]}</div><div class="track big" aria-hidden="true"><i class="${r[2]}" style="width:${r[1]}%"></i></div><div class="val"><b>${r[3].replace('over ','&gt;').replace('above ','&gt;')}</b></div></div>`).join('');
})();

