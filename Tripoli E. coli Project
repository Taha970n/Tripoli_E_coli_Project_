 "S", "S", "-"], "esbl": false, "mdr": false, "mdrI": false, "pan": true, "carb": false}, {"id": "E8", "sex": "F", "age": 46, "panel": "485", "res": ["S", "S", "S", "S", "S", "NI", "S", "S", "-", "S", "S", "S", "R", "S", "S", "-", "S", "S", "S", "I", "-", "-"], "esbl": false, "mdr": false, "mdrI": false, "pan": false, "carb": false}, {"id": "E9", "sex": "F", "age": 23, "panel": "483", "res": ["S", "S", "S", "S", "S", "-", "S", "S", "S", "S", "S", "S", "R", "I", "S", "X", "S", "-", "S", "S", "S", "-"], "esbl": false, "mdr": false, "mdrI": false, "pan": false, "carb": false}, {"id": "E10", "sex": "M", "age": 40, "panel": "431", "res": ["S", "S", "S", "S", "S", "R", "R", "S", "-", "R", "R", "S", "R", "I", "S", "X", "R", "-", "S", "X", "X", "I"], "esbl": true, "mdr": true, "mdrI": true, "pan": false, "carb": false}, {"id": "E11", "sex": "F", "age": 25, "panel": "431", "res": ["S", "R", "S", "R", "S", "NI", "S", "S", "-", "S", "S", "S", "R", "S", "S", "X", "S", "-", "S", "R", "R", "S"], "esbl": false, "mdr": true, "mdrI": true, "pan": false, "carb": true}, {"id": "E12", "sex": "M", "age": 45, "panel": "431", "res": ["S", "S", "S", "S", "S", "NI", "S", "S", "-", "S", "S", "S", "R", "I", "S", "X", "S", "-", "S", "X", "X", "I"], "esbl": false, "mdr": false, "mdrI": true, "pan": false, "carb": false}, {"id": "E13", "sex": "F", "age": 36, "panel": "431", "res": ["S", "S", "S", "S", "S", "NI", "S", "S", "-", "S", "S", "S", "S", "S", "S", "X", "S", "-", "S", "R", "R", "I"], "esbl": false, "mdr": false, "mdrI": false, "pan": false, "carb": false}, {"id": "E14", "sex": "M", "age": 5, "panel": "431", "res": ["S", "S", "S", "S", "S", "NI", "S", "S", "-", "S", "S", "S", "S", "S", "S", "X", "S", "-", "S", "X", "X", "S"], "esbl": false, "mdr": false, "mdrI": false, "pan": true, "carb": false}, {"id": "E15", "sex": "M", "age": 45, "panel": "431", "res": ["S", "S", "S", "S", "S", "R", "R", "S", "-", "R", "I", "S", "R", "S", "S", "X", "R", "-", "S", "R", "R", "I"], "esbl": true, "mdr": true, "mdrI": true, "pan": false, "carb": false}, {"id": "E16", "sex": "F", "age": 50, "panel": "431", "res": ["S", "S", "S", "I", "S", "NI", "S", "S", "-", "S", "S", "S", "S", "S", "S", "X", "S", "-", "S", "X", "X", "S"], "esbl": false, "mdr": false, "mdrI": false, "pan": false, "carb": false}, {"id": "E17", "sex": "F", "age": 7, "panel": "431", "res": ["S", "S", "S", "S", "S", "NI", "S", "S", "-", "S", "S", "S", "S", "S", "S", "X", "S", "-", "S", "X", "X", "I"], "esbl": false, "mdr": false, "mdrI": false, "pan": false, "carb": false}, {"id": "E18", "sex": "M", "age": 58, "panel": "431", "res": ["S", "S", "R", "I", "R", "R", "R", "R", "-", "R", "R", "R", "S", "S", "S", "X", "S", "-", "S", "X", "X", "S"], "esbl": false, "mdr": true, "mdrI": true, "pan": false, "carb": true}, {"id": "E19", "sex": "F", "age": 10, "panel": "431", "res": ["S", "S", "S", "S", "S", "NI", "S", "S", "-", "S", "S", "S", "S", "S", "S", "X", "S", "-", "S", "X", "X", "S"], "esbl": false, "mdr": false, "mdrI": false, "pan": true, "carb": false}, {"id": "E20", "sex": "M", "age": 15, "panel": "431", "res": ["S", "S", "S", "S", "S", "NI", "S", "S", "-", "S", "S", "S", "S", "S", "S", "X", "S", "-", "S", "X", "X", "I"], "esbl": false, "mdr": false, "mdrI": false, "pan": false, "carb": false}]};
const D = DATA.drugs, ISO = DATA.iso;
const $ = s => document.querySelector(s);
const NAMES = {S:'Susceptible',I:'Intermediate',R:'Resistant',X:'No category reported','-':'Not on this panel',NI:'No interpretation'};
const FILTERS = [
