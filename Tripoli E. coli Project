  $('#tiles .tile .v small').textContent='';
}
function renderBars(list){
  const s = stats(list).filter(x=>x.n>0).sort((a,b)=>(b.r/b.n-a.r/a.n)||(b.i/b.n-a.i/a.n)||a.d.localeCompare(b.d));
  $('#bn').textContent = list.length + ' isolates';
  if(!list.length){$('#bars').innerHTML='<div class="empty">No isolates in this group.</div>';return;}
  $('#bars').innerHTML = s.map(x=>{
    const rp=x.r/x.n*100, ip=x.i/x.n*100;
    return `<div class="brow ${x.r+x.i===0?'zero':''}" data-d="${esc(x.d)}" data-t="${esc(x.d)}: ${x.r} resistant, ${x.i} intermediate of ${x.n} with a category">
      <div class="nm">${esc(x.d)}</div>
      <div class="track" aria-hidden="true"><i class="r" style="width:${rp}%"></i><i class="i" style="width:${ip}%"></i></div>
      <div class="val"><b>${Math.round(rp)}%</b> ${x.r}/${x.n}</div></div>`;
  }).join('');
}
function renderGrid(list){
  const head = '<thead><tr><th></th>'+D.map(d=>`<th scope="col"><div>${esc(d)}</div></th>`).join('')+'<th></th></tr></thead>';
  const body = list.map(x=>{
    const tds = x.res.map((v,j)=>{
      const c = v==='-'?'N':(v==='NI'?'X':v);
      const ch = v==='-'?'–':(c==='S'||c==='I'||c==='R'?c:'');
      return `<td><div class="cell ${c}" tabindex="0" data-t="${x.id}, ${esc(D[j])}: ${NAMES[v]}" aria-label="${x.id} ${esc(D[j])} ${NAMES[v]}">${ch}</div></td>`;
